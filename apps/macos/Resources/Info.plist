         keychain, account dogecoinvm-wallet). -->
    <key>SUFeedURL</key><string>https://metaldoge.com/download/macos/appcast.xml</string>
    <key>SUPublicEDKey</key><string>HXXxvN6JHsJEj+NePSeFfvqur3Mm8Ed+zfoqLk8Frlo=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUScheduledCheckInterval</key><integer>86400</integer>
    <key>NSFaceIDUsageDescription</key><string>DogecoinVM Wallet uses Touch ID to unlock your key for each payment.</string>
</dict>
</plist>
